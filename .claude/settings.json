{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/bin/kodor.js session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/bin/kodor.js guard",
            "timeout": 180,
            "statusMessage": "Checking kodor's guards"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); case \"$input\" in *kodor/credentials*) ;; *) exit 0 ;; esac; printf '%s' \"$input\" | node \"$CLAUDE_PROJECT_DIR\"/bin/kodor.js guard credentials",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/bin/kodor.js guard permission",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/bin/kodor.js reviewers start 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/bin/kodor.js reviewers stop 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": ["~/.local/share/kodor/work"]
  }
}
