{
  "name": "@kodor-ai/kodor",
  "version": "0.0.0-development",
  "description": "Refines, builds, and reviews tickets with Claude Code sessions, from a board to a merged pull request.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodor-ai/kodor.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "kodor": "bin/kodor.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "agents",
    "approval-policies",
    "rules.md",
    "review.md",
    "poller.Dockerfile",
    ".claude-plugin",
    "docs",
    "settings.schema.json"
  ],
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --check . && tsc --noEmit && npm run -s spec:validate && node bin/kodor.js sync --check && node bin/kodor.js config check && vitest run --coverage",
    "prepack": "tsc -p tsconfig.build.json",
    "pack-check": "node tests/pack-check.mts",
    "site-check": "node --test tests/site-check.mts",
    "spec:validate": "DO_NOT_TRACK=1 openspec validate --all --strict --no-interactive"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "axe-core": "^4.14.0",
    "js-yaml": "^5.5.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "playwright": "*"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
